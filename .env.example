# ---------------------------------------------------------------------------
# AskKendal configuration. Copy to .env at the repo root.
# API keys can live here or in your shell/system environment (the shell wins).
# ---------------------------------------------------------------------------

# Database. Any Postgres 14+ works.
# Option A (no Docker): pnpm db:start runs an embedded Postgres (PGlite) on port 5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres
# The embedded server handles one query at a time: keep one connection per process.
DATABASE_POOL_MAX=1
# Option B: docker compose up -d
# DATABASE_URL=postgres://askkendal:askkendal@localhost:5433/askkendal

# --- Judgments: TypeSafe Jev --------------------------------------------------
# Jev sorts every ingested document: theme, Kendal relevance, urgency,
# "is this a decision", "does it name private individuals" and map location.
# Without a key, documents are still ingested with simple keyword rules.
JUDGE_PROVIDER=typesafe            # typesafe | none
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai
# Stop calling Jev during ingestion once this many tokens were used today (0 = no limit)
JUDGE_DAILY_TOKEN_CAP=400000
# Optional, only used to show an estimated cost on /council/settings (USD per million tokens)
TYPESAFE_PRICE_PER_MTOK=

# --- Chat / embeddings (not used yet: the "ask" feature is deferred) ----------
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=

# --- Ingestion ---------------------------------------------------------------
# How many listing pages of council news to walk (about 12 articles per page)
COUNCIL_NEWS_PAGES=8
INGEST_USER_AGENT=AskKendal/0.1 (civic information project for Kendal, Cumbria)

# --- Council door (magic-link login) -----------------------------------------
# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Comma-separated emails that are always allowed in, as admins
ADMIN_EMAILS=
# Comma-separated email domains allowed in as officers
COUNCIL_EMAIL_DOMAINS=westmorlandandfurness.gov.uk,kendaltowncouncil.gov.uk
# Public URL of the site, used in login emails
APP_URL=http://localhost:3000
# Optional SMTP for sending login links. Without it, links are printed to the server log.
SMTP_URL=
MAIL_FROM=AskKendal <no-reply@askkendal.local>

# --- Public site ---------------------------------------------------------------
# Optional link for sponsors and helpers, shown as "Get in touch" on /about
NEXT_PUBLIC_CONTACT_URL=
